# ---------------------------------------------------------------------------
# POS Pakaian — contoh variabel lingkungan
#
# Salin file ini menjadi `.env` untuk pemakaian lokal, atau isi nilainya di
# Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Penyimpanan Redis (WAJIB untuk Vercel) --------------------------------
# Ambil dari dashboard Upstash: tab "REST API" pada database Anda.
# Bila dua variabel ini kosong, aplikasi memakai file JSON di folder `data/`
# (hanya cocok untuk lokal, karena filesystem Vercel read-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Nama alternatif dari integrasi Vercel KV — isi salah satu pasang saja.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Nama sendiri (bila tidak ingin memakai penamaan Upstash/Vercel KV).
# POS_REDIS_REST_URL=
# POS_REDIS_REST_TOKEN=

# PENTING: URL harus dari tab "REST API" di Upstash (awalan https://).
# Menempelkan URL koneksi `redis://...` tidak akan terbaca — cek /api/health,
# nilai "redis.problem" akan berisi "url-bukan-rest".

# --- Opsional ---------------------------------------------------------------

# Port server lokal (default 3000)
# PORT=3000

# Zona waktu untuk penanggalan nota & laporan harian (default: waktu server)
# TZ=Asia/Jakarta

# Lokasi folder data pada mode file (default: ./data)
# POS_DATA_DIR=./data

# Lokasi folder aset statis (biasanya tidak perlu diubah)
# POS_PUBLIC_DIR=./public
