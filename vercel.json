{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__path=/api/$1" },
    { "source": "/(.*)", "destination": "/api/index.js?__path=/$1" }
  ]
}
